+    private fun artworkToContentUri(fileUriStr: String, authority: String, browserPkg: String): Uri? {
+        return try {
+            val parsed = Uri.parse(fileUriStr)
+            val path = parsed.path ?: return null
+            val file = File(path).canonicalFile
+            val base = FileProvider.getUriForFile(this, authority, file)
+
+            // Carry over any query string (the ?t=... cache-buster added by
+            // artwork replacement) BEFORE granting, and grant this exact uri.
+            //
+            // Uri permission matching is not path-only. Granting .../x.webp and
+            // then handing the media session .../x.webp?t=123 leaves the read
+            // ungranted: FileProvider does ignore the query when it opens the
+            // file, but that happens AFTER the permission check, so the mismatch
+            // surfaces as a SecurityException on every artwork load — measured at
+            // ~1/sec while playing a book whose cover came from cover search.
+            // SystemUI falls back to the in-band bitmap, so the cover still
+            // renders and the only visible symptom is log spam.
+            val contentUri = parsed.query
+                ?.let { base.buildUpon().encodedQuery(it).build() }
+                ?: base
+
+            // Grant to the subscribing browser (logged to diagnose unexpected packages).
+            Timber.d("AA artwork grant: browserPkg=$browserPkg uri=$contentUri")
+            grantUriPermission(browserPkg, contentUri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+
+            // Grant to additional AA rendering packages that may run in a different
+            // process/UID (e.g. coolwalk split-screen small pane renderer).
+            // SystemUI is included because the phone's media controls also try
+            // the metadata art URI (it falls back to the in-band bitmap when
+            // denied, but the denial throws a SecurityException on every load).
+            val extraPackages = listOf(
+                "com.google.android.projection.gearhead",
+                "com.google.android.embedded.projection",
+                "com.android.systemui"
+            )
+            for (pkg in extraPackages) {
+                if (pkg == browserPkg) continue  // already granted above
+                try {
+                    grantUriPermission(pkg, contentUri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                    Timber.d("AA artwork extra grant OK: pkg=$pkg")
+                } catch (e: Exception) {
+                    Timber.d("AA artwork extra grant skipped: pkg=$pkg reason=${e.message}")
+                }
+            }
+
+            contentUri
+        } catch (e: IllegalArgumentException) {
+            Timber.w("AA artwork outside FileProvider paths: $fileUriStr")
+            null
+        } catch (e: Exception) {
+            Timber.w("AA artwork URI conversion failed: ${e.message}")
+            null
+        }
+    }
+
+    private fun buildBrowseChildren(parentId: String, browserPkg: String): ImmutableList<MediaItem> {
+        return when {
+            parentId == "root" -> ImmutableList.of(
+                buildCategoryItem("recently_added", "Recently Added"),
+                buildCategoryItem("all_books", "All Books"),
+                buildCategoryItem("by_author", "By Author"),
+            )
+            parentId == "recently_added" -> {
+                val arr = readAutoCache()?.optJSONArray("recentlyAdded")
+                    ?: return ImmutableList.of()
+                buildBookItems(arr, browserPkg, "recent")
+            }
+            parentId == "all_books" -> {
+                val arr = readAutoCache()?.optJSONArray("allBooks")
+                    ?: return ImmutableList.of()
+                buildBookItems(arr, browserPkg, "all")
+            }
+            parentId == "by_author" -> {
+                val authors = readAutoCache()?.optJSONArray("authors")
+                    ?: return ImmutableList.of()
+                val builder = ImmutableList.builder<MediaItem>()
+                for (i in 0 until authors.length()) {
+                    val author = authors.getJSONObject(i)
+                    val name = author.optString("name", "")
+                    if (name.isNotEmpty()) {
+                        builder.add(buildCategoryItem("author__$name", name))
+                    }
+                }
+                builder.build()
+            }
+            parentId.startsWith("author__") -> {
+                val authorName = parentId.removePrefix("author__")
+                val authors = readAutoCache()?.optJSONArray("authors")
+                    ?: return ImmutableList.of()
+                for (i in 0 until authors.length()) {
+                    val author = authors.getJSONObject(i)
+                    if (author.optString("name") == authorName) {
+                        val books = author.optJSONArray("books")
+                            ?: return ImmutableList.of()
+                        return buildBookItems(books, browserPkg, "author")
+                    }
+                }
+                ImmutableList.of()
+            }
+            else -> ImmutableList.of()
+        }
+    }
+
+    private fun isCategoryId(id: String): Boolean =
+        id == "root" || id == "recently_added" || id == "all_books" ||
+        id == "by_author" || id.startsWith("author__")
+
+    // Case-insensitive AND-match of query terms against "title author".
+    // Used for both voice search ("play <book> on <app>") and typed search.
+    private fun searchBooks(query: String, browserPkg: String): ImmutableList<MediaItem> {
+        val terms = query.lowercase().split(" ").filter { it.isNotBlank() }
+        if (terms.isEmpty()) return ImmutableList.of()
+        val arr = readAutoCache()?.optJSONArray("allBooks")
+            ?: return ImmutableList.of()
+        val matched = JSONArray()
+        for (i in 0 until arr.length()) {
+            val book = arr.getJSONObject(i)
+            val haystack =
+                "${book.optString("title", "")} ${book.optString("author", "")}".lowercase()
+            if (terms.all { haystack.contains(it) }) matched.put(book)
+        }
+        return buildBookItems(matched, browserPkg, "search")
+    }
+
+    private fun <T> pageOf(all: ImmutableList<T>, page: Int, pageSize: Int): ImmutableList<T> {
+        val from = page * pageSize
+        val to = minOf(from + pageSize, all.size)
+        return if (from >= all.size) ImmutableList.of()
+        else ImmutableList.copyOf(all.subList(from, to))
+    }
